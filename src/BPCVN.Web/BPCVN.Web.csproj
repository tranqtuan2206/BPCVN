<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>29ea2269-3b8d-4195-8f6b-f213dfaa927b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BPCVN.Application\BPCVN.Application.csproj" />
    <ProjectReference Include="..\BPCVN.Infrastructure\BPCVN.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\FFmpeg\*" Link="FFmpeg\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\temp\**" Watch="false" />
    <Content Update="wwwroot\uploads\**" Watch="false" />
  </ItemGroup>

</Project>
