@model IEnumerable<BPCVN.Domain.Entities.Spec>
@{
    ViewData["Title"] = "KhÃ¡m phÃ¡ Builds";
}

<div class="section-header mb-4">
    <div>
        <h2 class="section-title">
            <i class="bi bi-compass me-2" style="opacity:0.5"></i><span data-i18n="explore.title">KhÃ¡m phÃ¡ Builds</span>
        </h2>
        <p class="section-subtitle">
            <span data-i18n="explore.found">TÃ¬m tháº¥y</span> <strong id="explore-count">@ViewBag.TotalResults</strong> <span data-i18n="explore.results">káº¿t quáº£</span>
        </p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Spec" asp-action="Create" class="btn-dark-lovable">
            <i class="bi bi-plus-circle"></i><span data-i18n="nav.createBuild">Táº¡o Build</span>
        </a>
    }
</div>

<!-- Search & Filter -->
<div class="card-lovable card-body-lovable mb-4">
    <form id="explore-form" method="get" class="row g-3 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label-lovable">
                <i class="bi bi-search me-1"></i><span data-i18n="explore.searchLabel">TÃ¬m kiáº¿m</span>
            </label>
            <input type="text" name="searchString" id="explore-search" value="@ViewBag.SearchString"
                class="form-control" autocomplete="off"
                data-i18n-placeholder="explore.searchPlaceholder" placeholder="Nháº­p tÃªn build, kit, switch..." />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label-lovable">
                <i class="bi bi-toggles me-1"></i><span data-i18n="explore.switchType">Loáº¡i Switch</span>
            </label>
            <select name="switchType" id="explore-switch-type" class="form-select">
                <option value="" data-i18n="explore.allTypes">-- Táº¥t cáº£ loáº¡i --</option>
                @foreach (var t in new[] { "Linear", "Tactile", "Clicky" })
                {
                    if ((string?)ViewBag.SwitchType == t)
                    {
                        <option value="@t" selected>@t</option>
                    }
                    else
                    {
                        <option value="@t">@t</option>
                    }
                }
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn-dark-lovable flex-grow-1">
                <i class="bi bi-funnel"></i><span data-i18n="explore.filter">Lá»c</span>
            </button>
        </div>
    </form>
</div>

<!-- Wrapper chá»©a káº¿t quáº£ â€” AJAX sáº½ inject HTML vÃ o Ä‘Ã¢y -->
<div id="explore-results">
    @await Html.PartialAsync("_ExploreResults", Model)
</div>

@section Scripts {
    <script>
        /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
         *  BPCVN Live Search â€” gÃµ Ä‘áº¿n Ä‘Ã¢u, káº¿t quáº£ nháº£y ra Ä‘áº¿n Ä‘áº¥y
         *  Debounce 300ms â€” trÃ¡nh spam request má»—i phÃ­m nháº¥n
         * â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

        (function () {
            /* Láº¥y elements */
            var searchInput    = document.getElementById('explore-search');
            var switchSelect   = document.getElementById('explore-switch-type');
            var resultsWrapper = document.getElementById('explore-results');
            var resultCount    = document.getElementById('explore-count');
            var exploreForm    = document.getElementById('explore-form');
            var timer          = null;

            if (!searchInput || !resultsWrapper) return;

            /* Táº¡o query string tá»« giÃ¡ trá»‹ hiá»‡n táº¡i */
            function buildQuery() {
                var s = searchInput.value.trim();
                var t = switchSelect ? switchSelect.value : '';
                var p = [];
                if (s) p.push('searchString=' + encodeURIComponent(s));
                if (t) p.push('switchType=' + encodeURIComponent(t));
                return p.length ? '?' + p.join('&') : '';
            }

            /* Fetch káº¿t quáº£ vÃ  cáº­p nháº­t DOM */
            function doSearch() {
                var qs = buildQuery();

                /* Loading state */
                resultsWrapper.style.opacity = '0.4';
                resultsWrapper.style.pointerEvents = 'none';
                resultsWrapper.style.transition = 'opacity 0.2s ease';

                var xhr = new XMLHttpRequest();
                xhr.open('GET', '/Spec/Explore' + qs, true);
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

                xhr.onload = function () {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        /* Inject HTML */
                        resultsWrapper.innerHTML = xhr.responseText;

                        /* Cáº­p nháº­t count */
                        var cards = resultsWrapper.querySelectorAll('.col');
                        var empty = resultsWrapper.querySelector('.empty-state');
                        if (resultCount) {
                            resultCount.textContent = empty ? '0' : cards.length;
                        }

                        /* Cáº­p nháº­t URL */
                        history.replaceState(null, '', '/Spec/Explore' + qs);

                        /* Khá»Ÿi táº¡o láº¡i Waveform Player cho cÃ¡c card Ã¢m thanh má»›i Ä‘Æ°á»£c inject */
                        if (typeof window.initWaveformPlayers === 'function') {
                            window.initWaveformPlayers();
                        }

                        /* Re-apply ngÃ´n ngá»¯ */
                        var lang = localStorage.getItem('bpcvn-lang') || 'vi';
                        if (typeof window.applyLang === 'function') {
                            window.applyLang(lang);
                        }
                    }
                    resultsWrapper.style.opacity = '1';
                    resultsWrapper.style.pointerEvents = 'auto';
                };

                xhr.onerror = function () {
                    resultsWrapper.style.opacity = '1';
                    resultsWrapper.style.pointerEvents = 'auto';
                };

                xhr.send();
            }

            /* Debounce â€” chá» 300ms sau phÃ­m cuá»‘i rá»“i má»›i fetch */
            function debounceSearch() {
                clearTimeout(timer);
                timer = setTimeout(doSearch, 300);
            }

            /* â”€â”€ Gáº¯n sá»± kiá»‡n â”€â”€ */

            /* Má»—i phÃ­m gÃµ â†’ debounce â†’ fetch */
            searchInput.addEventListener('input', debounceSearch);

            /* Äá»•i dropdown â†’ fetch ngay */
            if (switchSelect) {
                switchSelect.addEventListener('change', doSearch);
            }

            /* Cháº·n form submit (nÃºt Lá»c) â†’ dÃ¹ng AJAX thay tháº¿ */
            if (exploreForm) {
                exploreForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    doSearch();
                });
            }

            /* Back/Forward trÃ¬nh duyá»‡t */
            window.addEventListener('popstate', function () {
                var params = new URLSearchParams(window.location.search);
                searchInput.value = params.get('searchString') || '';
                if (switchSelect) switchSelect.value = params.get('switchType') || '';
                doSearch();
            });

        })();

        /* â”€â”€ Upvote handler â”€â”€ */
        async function handleUpvote(btn) {
            const testId = btn.dataset.testId;
            if (!testId) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            btn.disabled = true;

            try {
                const res = await fetch('/SoundTest/Upvote', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ testId })
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();

                if (data.success) {
                    btn.querySelector('.upvote-count').textContent = data.newCount;
                    // DÃ¹ng data.liked tá»« server Ä‘á»ƒ toggle class Ä‘Ãºng
                    if (data.liked) {
                        btn.classList.add('upvoted');
                    } else {
                        btn.classList.remove('upvoted');
                    }
                }
            } catch (err) {
                console.error('Upvote error:', err);
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}