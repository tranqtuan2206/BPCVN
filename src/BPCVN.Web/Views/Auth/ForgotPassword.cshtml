@model BPCVN.Application.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    var emailSent = ViewBag.EmailSent as bool? ?? false;
}

<section class="nb-auth-shell" aria-labelledby="forgotPasswordHeading">
    <div class="nb-auth-card">
        <!-- Dải đầu thẻ Neo-Brutalist với nhãn bước dạng phím cơ -->
        <header class="nb-auth-banner">
            <span class="nb-auth-step-tag" data-i18n="@(emailSent ? "auth.forgot.sentBadge" : "auth.forgot.badge")">
                @(emailSent ? "ĐÃ GỬI EMAIL" : "BƯỚC 01 / 02")
            </span>
            <h1 id="forgotPasswordHeading" class="nb-auth-banner-title"
                data-i18n="@(emailSent ? "auth.forgot.sentTitle" : "auth.forgot.title")">
                @(emailSent ? "Kiểm tra hộp thư của bạn" : "Quên mật khẩu")
            </h1>
            <p class="nb-auth-banner-sub" data-i18n="auth.forgot.subtitle">
                Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu
            </p>
        </header>

        <div class="nb-auth-body">
            @if (emailSent)
            {
                <!-- Trạng thái xác nhận sau khi gửi yêu cầu khôi phục -->
                <div class="nb-auth-sent-box">
                    <div class="nb-auth-sent-icon" aria-hidden="true">
                        <i class="bi bi-envelope-check-fill"></i>
                    </div>
                    <p class="mb-2 fw-bold" data-i18n="auth.forgot.sentMessage">
                        Nếu email tồn tại và đã kích hoạt trong hệ thống, chúng tôi đã gửi liên kết đặt lại mật khẩu cho bạn.
                    </p>
                    <div class="nb-auth-note mb-0">
                        <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>
                        <span data-i18n="auth.forgot.sentSpamHint">
                            Hãy kiểm tra thêm mục Thư rác (Spam) nếu sau 1 phút chưa thấy email.
                        </span>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <a asp-controller="Auth" asp-action="Login" class="nb-auth-submit text-decoration-none">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span data-i18n="auth.forgot.backToLogin">Quay lại đăng nhập</span>
                    </a>
                    <a asp-controller="Auth" asp-action="ForgotPassword" class="btn-ghost justify-content-center py-2">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span data-i18n="auth.forgot.sendAnother">Thử email khác</span>
                    </a>
                </div>
            }
            else
            {
                <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-lovable"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-lovable" data-i18n="auth.forgot.emailLabel">
                            Email tài khoản
                        </label>
                        <input asp-for="Email"
                               class="form-control form-control-lovable"
                               autocomplete="email"
                               data-i18n-placeholder="auth.forgot.emailPlaceholder"
                               placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="nb-auth-note mb-4">
                        <i class="bi bi-clock-history me-2" aria-hidden="true"></i>
                        <span data-i18n="auth.forgot.expiryNote">
                            Liên kết đặt lại mật khẩu chỉ có hiệu lực trong 15 phút và dùng một lần duy nhất.
                        </span>
                    </div>

                    <button type="submit" class="nb-auth-submit" id="forgotSubmitBtn">
                        <i class="bi bi-send-fill"></i>
                        <span data-i18n="auth.forgot.submit">Gửi liên kết khôi phục</span>
                    </button>
                </form>

                <hr class="divider" />

                <div class="text-center">
                    <a asp-controller="Auth" asp-action="Login" class="btn-cream w-100 justify-content-center">
                        <i class="bi bi-arrow-left"></i>
                        <span data-i18n="auth.forgot.backToLogin">Quay lại đăng nhập</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('forgotPasswordForm');
            const btn = document.getElementById('forgotSubmitBtn');
            if (!form || !btn) return;

            // Khóa nút gửi khi form hợp lệ đang submit để tránh gửi trùng lặp
            form.addEventListener('submit', function () {
                if (typeof $ !== 'undefined' && typeof $(form).valid === 'function' && !$(form).valid()) {
                    return;
                }
                btn.disabled = true;
            });
        })();
    </script>
}
