@model BPCVN.Application.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="nb-auth-shell" aria-labelledby="resetPasswordHeading">
    <div class="nb-auth-card">
        <!-- Dải đầu thẻ Neo-Brutalist -->
        <header class="nb-auth-banner">
            <span class="nb-auth-step-tag" data-i18n="auth.reset.badge">BƯỚC 02 / 02</span>
            <h1 id="resetPasswordHeading" class="nb-auth-banner-title" data-i18n="auth.reset.title">
                Đặt lại mật khẩu
            </h1>
            <p class="nb-auth-banner-sub" data-i18n="auth.reset.subtitle">
                Tạo mật khẩu mới an toàn cho tài khoản của bạn
            </p>
        </header>

        <div class="nb-auth-body">
            <!-- Hiển thị email tài khoản đang đặt lại mật khẩu -->
            <div class="nb-auth-email-chip mb-4">
                <span class="nb-auth-email-label" data-i18n="auth.reset.accountLabel">Tài khoản</span>
                <strong class="nb-auth-email-value">@Model.Email</strong>
            </div>

            <form asp-action="ResetPassword" method="post" id="resetPasswordForm" novalidate>
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-lovable"></div>

                <!-- Mật khẩu mới -->
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label-lovable" data-i18n="auth.reset.newLabel">
                        Mật khẩu mới
                    </label>
                    <div class="nb-input-group">
                        <input asp-for="NewPassword"
                               id="resetNewPassword"
                               class="form-control form-control-lovable"
                               autocomplete="new-password"
                               data-i18n-placeholder="auth.reset.newPlaceholder"
                               placeholder="Ít nhất 6 ký tự" />
                        <button type="button"
                                class="nb-eye-btn"
                                data-toggle-target="resetNewPassword"
                                data-i18n-title="auth.reset.togglePassword"
                                aria-label="Hiện / ẩn mật khẩu"
                                title="Hiện / ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
                </div>

                <!-- Xác nhận mật khẩu mới -->
                <div class="mb-3">
                    <label asp-for="ConfirmNewPassword" class="form-label-lovable" data-i18n="auth.reset.confirmLabel">
                        Xác nhận mật khẩu mới
                    </label>
                    <div class="nb-input-group">
                        <input asp-for="ConfirmNewPassword"
                               id="resetConfirmPassword"
                               class="form-control form-control-lovable"
                               autocomplete="new-password"
                               data-i18n-placeholder="auth.reset.confirmPlaceholder"
                               placeholder="Nhập lại mật khẩu mới" />
                        <button type="button"
                                class="nb-eye-btn"
                                data-toggle-target="resetConfirmPassword"
                                data-i18n-title="auth.reset.togglePassword"
                                aria-label="Hiện / ẩn mật khẩu"
                                title="Hiện / ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="nb-auth-note mb-4">
                    <i class="bi bi-shield-check me-2" aria-hidden="true"></i>
                    <span data-i18n="auth.reset.hint">
                        Mật khẩu tối thiểu 6 ký tự. Nên dùng mật khẩu khác với mật khẩu cũ.
                    </span>
                </div>

                <button type="submit" class="nb-auth-submit" id="resetSubmitBtn">
                    <i class="bi bi-check2-square"></i>
                    <span data-i18n="auth.reset.submit">Cập nhật mật khẩu</span>
                </button>
            </form>

            <hr class="divider" />

            <div class="text-center">
                <a asp-controller="Auth" asp-action="Login" class="btn-cream w-100 justify-content-center">
                    <i class="bi bi-arrow-left"></i>
                    <span data-i18n="auth.forgot.backToLogin">Quay lại đăng nhập</span>
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Bật/tắt hiển thị mật khẩu cho các nút mắt
            document.querySelectorAll('.nb-eye-btn[data-toggle-target]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const input = document.getElementById(btn.getAttribute('data-toggle-target'));
                    const icon = btn.querySelector('i');
                    if (!input || !icon) return;

                    const isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            });

            const form = document.getElementById('resetPasswordForm');
            const submitBtn = document.getElementById('resetSubmitBtn');
            if (form && submitBtn) {
                form.addEventListener('submit', function () {
                    if (typeof $ !== 'undefined' && typeof $(form).valid === 'function' && !$(form).valid()) {
                        return;
                    }
                    submitBtn.disabled = true;
                });
            }
        })();
    </script>
}
