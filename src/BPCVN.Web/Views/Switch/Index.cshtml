@model IEnumerable<BPCVN.Domain.Entities.Switch>
@{
    ViewData["Title"] = "Switch Catalog";

    // Danh sÃ¡ch unique type & brand tá»« Controller cho dropdown filter
    var types = ViewBag.Types as List<string> ?? new();
    var brands = ViewBag.Brands as List<string> ?? new();
}

<!-- â”€â”€ Page header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<div class="section-header">
    <div>
        <h2 class="section-title">
            <i class="bi bi-toggles me-2" style="opacity:0.5"></i>Switch Catalog
        </h2>
        <p class="section-subtitle">
            <span id="switchCount">@Model.Count()</span> <span data-i18n="switch.countSuffix">switches trong cÆ¡ sá»Ÿ dá»¯ liá»‡u</span>
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Switch" asp-action="Create" class="btn-dark-lovable">
                <i class="bi bi-plus-circle"></i>ThÃªm Switch
            </a>
        }
        <span class="badge-count" id="switchBadge" style="font-size:0.9375rem;padding:6px 16px">
            @Model.Count() Switches
        </span>
    </div>
</div>

<!-- â”€â”€ Bá»™ lá»c & Live Search â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<div class="card-lovable card-body-lovable mb-4">
    <div class="row g-3 align-items-end">
        <!-- Ã” tÃ¬m kiáº¿m -->
        <div class="col-12 col-md-5">
            <label class="form-label-lovable">
                <i class="bi bi-search me-1"></i><span data-i18n="switch.searchLabel">TÃ¬m kiáº¿m</span>
            </label>
            <input type="text" id="searchInput" class="form-control"
                placeholder="Nháº­p tÃªn switch hoáº·c brand..." data-i18n-placeholder="switch.index.searchPlaceholder" autocomplete="off" />
        </div>

        <!-- Dropdown Loáº¡i Switch -->
        <div class="col-6 col-md-3">
            <label class="form-label-lovable">
                <i class="bi bi-toggles me-1"></i><span data-i18n="switch.typeLabel">Loáº¡i</span>
            </label>
            <select id="filterType" class="form-select">
                <option value="" data-i18n="switch.index.allTypes">-- Táº¥t cáº£ --</option>
                @foreach (var t in types)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>

        <!-- Dropdown Brand -->
        <div class="col-6 col-md-3">
            <label class="form-label-lovable">
                <i class="bi bi-building me-1"></i>Brand
            </label>
            <select id="filterBrand" class="form-select">
                <option value="" data-i18n="switch.index.allBrands">-- Táº¥t cáº£ --</option>
                @foreach (var b in brands)
                {
                    <option value="@b">@b</option>
                }
            </select>
        </div>

        <!-- NÃºt xÃ³a bá»™ lá»c -->
        <div class="col-12 col-md-1 d-flex">
            <button type="button" id="clearFilters" class="btn-ghost flex-grow-1" title="XÃ³a bá»™ lá»c">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>
</div>

<!-- â”€â”€ Container danh sÃ¡ch Switch â€” ná»™i dung Ä‘Æ°á»£c thay báº±ng AJAX â”€â”€â”€â”€â”€ -->
<div id="switch-list-container">
    <partial name="_SwitchListPartial" model="Model" />
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // â”€â”€ Debounce â€” trÃ¬ hoÃ£n gá»i hÃ m cho Ä‘áº¿n khi user ngá»«ng gÃµ â”€â”€
            // delay: thá»i gian chá» (ms) ká»ƒ tá»« láº§n nháº¥n phÃ­m cuá»‘i
            function debounce(func, delay) {
                let timerId;
                return function (...args) {
                    clearTimeout(timerId);
                    timerId = setTimeout(() => func.apply(this, args), delay);
                };
            }

            // â”€â”€ Tham chiáº¿u DOM â”€â”€
            const searchInput = document.getElementById('searchInput');
            const filterType = document.getElementById('filterType');
            const filterBrand = document.getElementById('filterBrand');
            const clearBtn = document.getElementById('clearFilters');
            const container = document.getElementById('switch-list-container');
            const switchCount = document.getElementById('switchCount');
            const switchBadge = document.getElementById('switchBadge');

            // â”€â”€ Gá»i API láº¥y danh sÃ¡ch Switch Ä‘Ã£ lá»c â”€â”€
            async function fetchSwitches() {
                // GhÃ©p táº¥t cáº£ filter thÃ nh query string
                const params = new URLSearchParams();
                const search = searchInput.value.trim();
                const type = filterType.value;
                const brand = filterBrand.value;

                if (search) params.set('searchQuery', search);
                if (type) params.set('type', type);
                if (brand) params.set('brand', brand);

                try {
                    const res = await fetch(`/Switch/Index?${params.toString()}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!res.ok) throw new Error(`HTTP ${res.status}`);

                    // GÃ¡n HTML partial vÃ o container
                    const html = await res.text();
                    container.innerHTML = html;

                    // Cáº­p nháº­t bá»™ Ä‘áº¿m â€” Ä‘áº¿m sá»‘ card hiá»‡n táº¡i
                    const count = container.querySelectorAll('.col').length;
                    switchCount.textContent = count;
                    switchBadge.textContent = count + ' Switches';
                } catch (err) {
                    console.error('Fetch switches error:', err);
                }
            }

            // â”€â”€ Gáº¯n sá»± kiá»‡n â”€â”€
            // Live search â€” debounce 350ms Ä‘á»ƒ trÃ¡nh spam request
            searchInput.addEventListener('input', debounce(fetchSwitches, 350));

            // Dropdown filter â€” gá»i ngay khi thay Ä‘á»•i
            filterType.addEventListener('change', fetchSwitches);
            filterBrand.addEventListener('change', fetchSwitches);

            // NÃºt xÃ³a bá»™ lá»c â€” reset táº¥t cáº£ input/select rá»“i fetch láº¡i
            clearBtn.addEventListener('click', function () {
                searchInput.value = '';
                filterType.value = '';
                filterBrand.value = '';
                fetchSwitches();
            });
        })();
    </script>
}
