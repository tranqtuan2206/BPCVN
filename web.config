<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- ASP.NET Core handler — bắt buộc để IIS forward request đến app -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\BPCVN.dll"
                  stdoutLogEnabled="false" hostingModel="inprocess" />

      <!-- Tăng giới hạn upload: 200MB, timeout 10 phút -->
      <httpRuntime maxRequestLength="204800" executionTimeout="600" />
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </system.webServer>
  </location>
</configuration>
