<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- maxRequestLength: 200MB (đơn vị KB) — cho phép upload video lớn -->
    <!-- executionTimeout: 600 giây (10 phút) — đủ cho upload chậm + xử lý Cloudinary -->
    <httpRuntime maxRequestLength="204800" executionTimeout="600" />
    <requestFiltering>
      <!-- maxAllowedContentLength: 200MB (đơn vị byte) — giới hạn II -->
      <requestLimits maxAllowedContentLength="209715200" />
    </requestFiltering>
  </system.webServer>
</configuration>
